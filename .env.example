# TRIADA local configuration
LLM_PROVIDER=fake
# LLM_PROVIDER=openai-compatible  # OpenAI-compatible /chat/completions endpoint.
# LLM_PROVIDER=openai-responses    # OpenAI Responses API.
# LLM_PROVIDER=codex-bridge        # No API key; Codex-operated demo bridge.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=fake-devops-model

# Default local database. Docker Compose overrides this with PostgreSQL asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./triada.db

# Optional future broker/cache URL.
REDIS_URL=

# Public summaries are exposed through thinking_summary_delta.
# Raw provider reasoning, when returned by the model API, is stored as sensitive audit data.
CAPTURE_REASONING_SUMMARY=true
PASS_REASONING_SUMMARY_TO_AUDITOR=true

EVENT_OUTPUT_DIR=.triada/artifacts
SHELL_TIMEOUT_SECONDS=60
MAX_TOOL_OUTPUT_BYTES=65536
